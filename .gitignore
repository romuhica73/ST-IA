# whisper.cpp: external clone of ggml-org/whisper.cpp (pinned tag/SHA documented
# in docs/architecture/ADR-001-transcription-engine.md and the mission report).
# Not vendored: it is its own git repo and includes multi-GB model binaries.
/engine/whisper.cpp/

*.o
*.dSYM/

# macOS
.DS_Store

# Personal test media (never committed): source recordings and any WAV
# derived from them. Transcripts (SRT/TXT) and run logs are still tracked.
/spike/samples/fr_sample_16k_mono.wav

# Private media, by extension rather than by location. ST-IA is a media
# transcription app: the directory rules below (/mockups/, test-media/) cover
# the two known locations, but a personal recording dropped anywhere else in
# the tree would have had no safety net at all. The public-domain JFK fixtures
# used by the spike harness are the only media the repository ships.
*.mov
*.MOV
*.mp4
*.MP4
*.m4a
*.m4v
*.mp3
*.wav
*.aac
*.flac
!/spike/samples/jfk_16k_mono.wav
!/spike/samples/jfk_from_mp4_16k_mono.wav
!/spike/samples/jfk_synthetic.mp4

# UI mockups: reference-only working files (includes a personal video),
# not part of the shipped repository.
/mockups/

# Node / frontend. `dist` is anchored: unanchored, it would also swallow any
# future source directory named `dist` anywhere in src/.
node_modules
/dist
/dist-ssr
*.local
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Rust / Tauri
/src-tauri/target/
/src-tauri/gen/schemas
# Permission files tauri-build derives from the app ACL manifest in build.rs.
# Generated on every build, exactly like gen/schemas — build.rs is the source
# of truth for which commands exist, and these are its output.
/src-tauri/permissions/autogenerated/

# Sidecar build scratch space (FFmpeg source tree, object files). The
# resulting binaries in src-tauri/binaries/ are committed (see ADR-003);
# this intermediate tree is not.
/build-tmp/

# Editor and local agent tooling. These are per-contributor settings: on a
# public repository nobody else has the maintainer's global gitignore, so the
# rule has to live here.
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json
settings.local.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local, non-committed media fixtures used for manual qualification.
test-media/private/
test-media/

# Secrets and local credentials. ST-IA has no account, no API key and no
# backend, so nothing here should ever exist — these rules are here so that a
# contributor experimenting locally cannot commit one by accident.
.env
.env.*
!.env.example
*.pem
*.p12
*.key
*.keystore
*.mobileprovision
*.cer
*.certSigningRequest
secrets.json
credentials.json

# Signing / notarization material (M9). Never committed.
*.entitlements.local
notarization-*.json

# Build artifacts produced by `pnpm tauri build`. The bundle lives under
# src-tauri/target/ (already ignored); these cover a copy left at the root.
*.dmg
*.app/
*.pkg

# Release artifacts assembled by scripts/package-release.sh. Regenerated
# from a build on demand, never committed: they are hundreds of megabytes,
# they are unsigned, and Git is not a binary distribution channel.
/release-artifacts/

# Downloaded Whisper models. The real location is Application Support, but a
# 574 MB .bin must never be committable from anywhere in the tree. The
# `.download` suffix is the partial-download name the model manager itself
# writes (domain/model.rs) — `*.bin` does not match `*.bin.download`, because
# the glob is anchored at the end of the name.
*.bin
!src-tauri/icons/*.bin
*.download
models/

# Logs and crash dumps. The tracked spike logs under spike/out/ are
# qualification evidence and are committed deliberately — they are matched by
# name, not by this pattern.
*.log
!spike/out/**/*.log
*.crash
*.dmp

# macOS metadata
.DS_Store
._*
.Spotlight-V100
.Trashes
