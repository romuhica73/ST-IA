{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Capability for the main window: core defaults, native open-file dialog, execution of exactly the two named transcription sidecars, revealing a generated output file in Finder (no generic shell access), and every ST-IA application command except the splash window's own signal.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "whisper-cli", "sidecar": true, "args": true },
        { "name": "ffmpeg", "sidecar": true, "args": true }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "allow-inspect-media",
    "allow-start-transcription",
    "allow-get-transcription-status",
    "allow-cancel-transcription",
    "allow-open-output-folder",
    "allow-get-model-status",
    "allow-get-model-manifest",
    "allow-get-model-cards",
    "allow-install-model",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-app-version",
    "allow-notify-ui-ready",
    "allow-fit-window"
  ]
}
