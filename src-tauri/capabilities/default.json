{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: core defaults, native open-file dialog, execution of exactly the two named transcription sidecars, and opening the output folder in Finder (no generic shell access).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "whisper-cli", "sidecar": true, "args": true },
        { "name": "ffmpeg", "sidecar": true, "args": true }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/**" }, { "path": "/Volumes/**" }]
    }
  ]
}
